# /etc/systemd/system/propertyselection.service
[Unit]
Description=Bitrix24 app: property selections for newflat72.ru
After=network.target

[Service]
Type=simple
User=propsel
WorkingDirectory=/opt/propertyselection
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
