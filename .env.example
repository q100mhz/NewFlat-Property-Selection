# Адрес, по которому приложение доступно из интернета (без слеша на конце)
BASE_URL=https://propertyselection.itb2bhost.ru
PORT=3000
HOST=127.0.0.1

# Из Битрикс24: Разработчикам → Другое → Локальное приложение → «Код приложения» и «Ключ приложения»
B24_CLIENT_ID=local.xxxxxxxxxxxxxx.xxxxxxxx
B24_CLIENT_SECRET=
# Домен портала агентства (защита от чужих порталов), например: agency.bitrix24.ru
B24_ALLOWED_DOMAINS=

# Случайная строка от 32 символов: openssl rand -hex 32
SESSION_SECRET=

# Каталог
SITE_URL=https://newflat72.ru
CRAWL_INTERVAL_HOURS=6
CRAWL_DELAY_MS=400

# Оформление страницы для клиента
AGENCY_NAME=Центр Недвижимости
AGENCY_PHONE=
AGENCY_LOGO=https://newflat72.ru/upload/citrus.arealty/e1b/e1b5db5b6f99e457d316a237fbb6a512.png
